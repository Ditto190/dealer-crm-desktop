{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dealerflow Desk",
  "version": "0.1.0",
  "identifier": "com.dealerflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dealerflow Desk",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Dealer relationship workspace"
  }
}
